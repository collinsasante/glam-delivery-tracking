# Copy this file to .env.local and fill in your values.
# Never commit .env.local — it is already excluded by .gitignore.

# Postgres — server-only, never expose to client
DATABASE_URL=postgresql://user:password@localhost:5432/glam_delivery

# Session — keep this secret, used to sign session JWTs (generate with: openssl rand -base64 32)
AUTH_SECRET=your_auth_secret_min_32_chars

# Firebase Admin SDK — server-only, never expose to client
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_CLIENT_EMAIL=your_firebase_client_email
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Firebase Client SDK — safe to expose (NEXT_PUBLIC_ prefix)
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_firebase_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id
NEXT_PUBLIC_FIREBASE_VAPID_KEY=your_web_push_vapid_key

# AWS S3 + Cloudflare CDN — server-only except CDN_DOMAIN, which is also read
# client-side indirectly via next.config.ts's image remotePatterns/CSP
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_iam_access_key_id
AWS_SECRET_ACCESS_KEY=your_iam_secret_access_key
S3_BUCKET_NAME=your_bucket_name
CDN_DOMAIN=cdn.yourdomain.com

# Google Maps — GOOGLE_MAPS_API_KEY is server-only (used by app/api/places routes);
# NEXT_PUBLIC_ variant is exposed to the client
GOOGLE_MAPS_API_KEY=your_google_maps_api_key
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# Resend — server-only, used for branded invite emails (optional — falls back to
# Firebase's own password-reset email if unset)
RESEND_API_KEY=your_resend_api_key
FROM_EMAIL=Drop <noreply@yourdomain.com>

# Mattermost — server-only, optional. Incoming webhook URL for ops notifications
# (new delivery, delivery completed/on hold, new expense submitted). Leave unset
# to disable notifications entirely.
MATTERMOST_WEBHOOK_URL=https://your-mattermost.example.com/hooks/xxxxxxxxxxxxxxxxxxxxxxxxxx

# Copy to .env.production on the VPS (chmod 600, never commit it — already
# excluded by .gitignore). Consumed by docker-compose.yml via `env_file`.

NODE_ENV=production

# Postgres — POSTGRES_PASSWORD is read by the `db` service itself; DATABASE_URL
# (read by the `app` service) must point at the compose service name `db`, not
# localhost, since app and db are separate containers on the compose network.
POSTGRES_PASSWORD=use_a_long_random_password
DATABASE_URL=postgresql://glam:use_a_long_random_password@db:5432/glam_delivery

AUTH_SECRET=your_auth_secret_min_32_chars

FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_CLIENT_EMAIL=your_firebase_client_email
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_firebase_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id
NEXT_PUBLIC_FIREBASE_VAPID_KEY=your_web_push_vapid_key

# App upload credentials — scoped to PutObject/GetObject on this bucket only (see
# the migration plan for the IAM policy JSON). Backups use a SEPARATE IAM user/
# policy configured directly in docker/backup-db.sh's environment, not this one.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_iam_access_key_id
AWS_SECRET_ACCESS_KEY=your_iam_secret_access_key
S3_BUCKET_NAME=your_bucket_name
CDN_DOMAIN=cdn.yourdomain.com

GOOGLE_MAPS_API_KEY=your_google_maps_api_key
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key

RESEND_API_KEY=your_resend_api_key
FROM_EMAIL=Drop <noreply@yourdomain.com>

# Mattermost — optional. Leave unset to disable ops notifications entirely.
MATTERMOST_WEBHOOK_URL=https://your-mattermost.example.com/hooks/xxxxxxxxxxxxxxxxxxxxxxxxxx
